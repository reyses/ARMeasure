<?xml version="1.0" encoding="utf-8"?>
<!--
  Wiring (NOT yet applied): add to <application> in AndroidManifest.xml
      android:networkSecurityConfig="@xml/network_security_config"

  Android cannot express CIDR ranges here, so the platform-level cleartext switch is on and the
  real rule (https anywhere; http only to 10/8, 172.16/12, 192.168/16 IPv4 literals) is enforced in
  processing/PcLink.kt (UrlPolicy + an OkHttp interceptor that rejects everything else).
  Without this file targetSdk 37 blocks all http, i.e. the LAN mode.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
