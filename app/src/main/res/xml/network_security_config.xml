<?xml version="1.0" encoding="utf-8"?>
<!--
  Applied from AndroidManifest.xml (<application android:networkSecurityConfig>).

  Why cleartext is permitted at platform level: the PC link supports plain http on the LAN (a self-signed
  https certificate is not trusted), and Android's network security config cannot express IP ranges
  (a domain-config only matches a host name or one exact IP literal, never 192.168.0.0/16). Without
  cleartext here, targetSdk 37 would block every http request, i.e. the whole LAN mode.

  The real rule is enforced in code, not here: processing/PcLink.kt (UrlPolicy + an OkHttp interceptor)
  allows https anywhere and plain http ONLY to IPv4 literals in 10/8, 172.16/12 and 192.168/16, refuses
  everything else and does not follow redirects. HttpPcLink (OkHttp) is the only plain-http client in the
  app; ARCore, SceneView and the Google code scanner use https only. So the platform flag is deliberately
  loose and UrlPolicy is the enforcement.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
